POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank_dev_password_change_me
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
INTERNAL_SERVICE_SECRET=change_me_internal_service_secret
MAIL_HOST=mailpit
MAIL_PORT=1025
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
ACCOUNT_SERVICE_URL=http://account-service:3003
TRANSACTION_SERVICE_URL=http://transaction-service:3004
CREDIT_CARD_SERVICE_URL=http://credit-card-service:3005
LOAN_SERVICE_URL=http://loan-service:3006
DOCUMENT_SERVICE_URL=http://document-service:3007
NOTIFICATION_SERVICE_URL=http://notification-service:3008
ADMIN_SERVICE_URL=http://admin-service:3009

# Splunk RUM (browser) — set SPLUNK_RUM_ACCESS_TOKEN in .env.splunk (see .env.splunk.example)
VITE_SPLUNK_REALM=us1
VITE_DEPLOYMENT_ENVIRONMENT=banking-app

# OpenTelemetry — export to local collector (forwards to Splunk when .env.splunk is configured)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Shown in Splunk APM environment filter (e.g. banking-app, staging, workshop)
DEPLOYMENT_ENVIRONMENT=banking-app
OTEL_SDK_DISABLED=false

# Set to true to disable OTEL export (e.g. local dev without collector)
# OTEL_SDK_DISABLED=true
