# Copy to .env.splunk and fill in your Splunk Observability Cloud values.
# .env.splunk is gitignored — NEVER commit it.
#
# Get these from: Organization Settings → Access Tokens (ingest) in Splunk Observability Cloud

SPLUNK_REALM=us1
SPLUNK_ACCESS_TOKEN=your-ingest-token-here
SPLUNK_INGEST_URL=https://ingest.us1.signalfx.com
SPLUNK_API_URL=https://api.us1.signalfx.com
# Log Observer ingest URL (no Splunk Platform index required).
# Default: ${SPLUNK_INGEST_URL}/v1/log
# If export returns HTTP 404, try the observability.splunkcloud.com variant for your realm:
# SPLUNK_LOG_INGEST_URL=https://ingest.us1.observability.splunkcloud.com/v1/log
SPLUNK_LOG_INGEST_URL=https://ingest.us1.signalfx.com/v1/log

# RUM browser agent (public token — visible in client-side code by design)
# Create in Splunk O11y → Settings → Access Tokens → New Token → RUM Token
SPLUNK_RUM_ACCESS_TOKEN=your-rum-token-here
