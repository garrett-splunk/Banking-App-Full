{
  "name": "banking-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend",
    "tests"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @banking/shared",
    "dev:gateway": "npm run dev -w @banking/api-gateway",
    "migrate:all": "bash scripts/migrate-all.sh",
    "seed": "tsx scripts/seed-demo-data.ts",
    "traffic": "tsx scripts/generate-demo-traffic.ts",
    "traffic:all": "bash scripts/run-demo-traffic.sh all",
    "traffic:rum": "tsx scripts/generate-rum-traffic.ts",
    "flags": "tsx scripts/toggle-feature-flag.ts",
    "demo:up": "bash scripts/demo-up.sh",
    "demo:up:full": "bash scripts/demo-up.sh full",
    "demo:up:app": "bash scripts/demo-up.sh app",
    "demo:up:o11y": "bash scripts/demo-up.sh o11y",
    "demo:up:workshop": "bash scripts/demo-up.sh workshop",
    "demo:run": "bash scripts/demo-up.sh full && bash scripts/run-demo-traffic.sh all",
    "demo:traffic": "bash scripts/run-demo-traffic.sh all",
    "demo:traffic:api": "bash scripts/run-demo-traffic.sh api",
    "demo:traffic:rum": "bash scripts/run-demo-traffic.sh rum",
    "demo:down": "bash scripts/demo-teardown.sh",
    "demo:down:full": "bash scripts/demo-teardown.sh full",
    "demo:down:app": "bash scripts/demo-teardown.sh app",
    "demo:down:o11y": "bash scripts/demo-teardown.sh o11y",
    "demo:down:workshop": "bash scripts/demo-teardown.sh workshop",
  "minikube:up": "bash scripts/minikube-up.sh",
  "minikube:down": "bash scripts/minikube-down.sh",
  "minikube:build": "bash scripts/k8s-build-images.sh",
  "minikube:seed": "bash scripts/minikube-seed.sh",
  "minikube:port-forward": "bash scripts/minikube-port-forward.sh",
    "docker:down": "docker compose down",
    "docker:down:clean": "docker compose down -v",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.11.10",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "pg": "^8.13.1",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
